{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git fetch:*)",
      "Bash(python3 -m py_compile:*)"
    ],
    "deny": [
      "Read(./config/config.json)",
      "Read(./.claude/settings.local.json)"
    ]
  }
}
