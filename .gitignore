# ============================================================
# 密钥 / 本机配置（绝对不能进库）
# ============================================================
config.json
# config/ 下几乎全是密钥和本机状态：config.json 及其 .bak 备份、panel_secret.key、
# admin.json、email.txt、webhook.json、reply_count.json —— 一律挡住。
# 唯独放行人设 config/prompt/*.md：那是纯文本、不含任何密钥，而且是产品的脸，
# 只存在生产机上迟早会丢（2026-08-03 融合人设时发现版本库里一个都没有）。
# gitignore 的规矩：父目录被排除后，子文件的 ! 例外不生效，所以只能逐层放行。
/config/*
!/config/prompt/
/config/prompt/*
!/config/prompt/*.md
wxautox_activate.py
.claude/settings.local.json

# ============================================================
# 环境与构建产物
# ============================================================
.venv
venv/
venv2/
UI_default/
UI2/
UI3/
build/
dist/
__pycache__/
.pycache_verify/
/releases/
*.zip
*.whl
*.exe
*.spec
*.ui

# ============================================================
# 日志与运行时目录
# ============================================================
*.log
logs/
wxauto_logs/
panel_logs/
memory/
backup/
old_wxbot_config/
wxautox文件下载/
docs/admin

# ============================================================
# 插件运行时数据（真相源在别处，仓库只放代码）
# ============================================================
# ui_watchdog：自启动标记、重启历史
plugins/ui_watchdog/data/
# wechat_checkin：码池 sqlite + 每日 JSON 备份（真相源在 hkbohai，见 CLAUDE.md 3.3）
plugins/wechat_checkin/data/
plugins/wechat_checkin/imports/
# ncc_community / ncc_kb：群内指令实时写盘的运行配置（见 CLAUDE.md 3.6 / 3.9）
plugins/ncc_community/data/*.json
# 后台任务触发器的请求/结果（运行时产物，见 plugins/ncc_community/task_runner.py）
plugins/ncc_community/data/task_*.txt
plugins/ncc_kb/data/
# ai_news_note：抓取数据与已发送标记
plugins/ai_news_note/data/
plugins/ai_news_note/last_sent.txt
# listen_health：探针采样流水 + 本机配置（默认值写在 config.py 的 DEFAULTS，
# 文件缺失自动回落，所以 data/ 整个不进库，与其它插件一致）
plugins/listen_health/data/

# ============================================================
# 临时文件 / 手工备份
# ============================================================
# 改核心文件前手动留的 .bak-xxx 副本，属于本机临时物
*.bak
*.bak-*
tmp_*.py
test.py
test2.py
test3.py
.DS_Store
wx.png
*.png
# 例外：上游文档截图本来就在版本库里
!docs/img/*.png
